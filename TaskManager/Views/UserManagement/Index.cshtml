@model IEnumerable<TaskManager.Models.UserRoleViewModel>

@{
    ViewData["Title"] = "User Management";
}

<h2 class="mt-3">User Management (Super Admin)</h2>

<form method="get" asp-action="Index" class="row g-3 mb-3">
    <div class="col-md-4">
        <input type="text" name="search" class="form-control" placeholder="Search by name or email" value="@ViewBag.Search" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

<table class="table table-bordered table-striped mt-4">
    <thead class="table-dark">
        <tr>
            <th>Email</th>
            <th>Full Name</th>
            <th>Cell Phone</th>
            <th>Current Role</th>
            <th>Assign New Role</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>@user.FullName</td>
                <td>@user.CellPhone</td>
                <td>@string.Join(", ", user.Roles)</td>
                <td>
                    <form asp-action="AssignRole" method="post">
                        <input type="hidden" name="userId" value="@user.UserId" />
                        <select name="role" class="form-select">
                            <option value="User">User</option>
                            <option value="Admin">Admin</option>
                            <option value="SuperAdmin">SuperAdmin</option>
                        </select>
                        <button type="submit" class="btn btn-sm btn-primary mt-2">Update Role</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
<div class="mt-4">
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
</div>
